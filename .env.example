# Public canonical base URL for generated share links and canonical metadata.
# Use the full origin without a trailing slash.
HOST_URL=https://your-site.netlify.app

# Server-only TMDB key. Used by netlify/functions/tmdb.mjs and share.mjs.
TMDB_API_KEY=

# Supabase project URL and browser-safe publishable/anon key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
